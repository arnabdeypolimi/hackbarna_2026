# LLM — Nebius Token Factory (OpenAI-compatible)
# Key: https://tokenfactory.nebius.com/  Catalog: https://tokenfactory.nebius.com/models/catalog
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Non-thinking instruct model, ~0.4 s to first token. Reasoning models
# (DeepSeek-V4-Flash-0731, GLM-5.x, Kimi) think for ~1 s before the first word.
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# SLNG — one key covers both STT and TTS
SLNG_API_KEY=
SLNG_BASE_URL=api.slng.ai
# Routes to the nearest EU datacenter via X-World-Part-Override (ap | eu | na)
SLNG_WORLD_PART=eu
# STT: Deepgram Nova 3 on SLNG (alternative: reson8/reson8stt:v1). The session
# language (avatars.yaml) is passed to whichever model is set; check coverage for ca.
SLNG_STT_MODEL=deepgram/nova:3
# TTS: Cartesia Sonic 3 (init: linear16 @ 24 kHz). Voices are per avatar, see avatars.yaml.
SLNG_TTS_MODEL=cartesia/sonic:3
SLNG_TTS_ENCODING=linear16
SLNG_TTS_SAMPLE_RATE=24000

# Anam. Avatar ids, models and their voices live in avatars.yaml (repo root);
# a session picks one avatar and one language (en | es | fr | ca) at POST /sessions.
ANAM_API_KEY=
# AVATARS_FILE=/path/to/avatars.yaml
# Anam avatar ids are account-scoped. If the catalog's default avatar "does not
# exist" under your key, point the default at an avatar (or a saved Persona from
# Anam Lab, which wins) that your account owns. Other catalog avatars are unaffected.
ANAM_AVATAR_ID=
ANAM_PERSONA_ID=

# Turn-taking: seconds of silence after the last word before the avatar answers
TURN_SILENCE_S=0.5

# --- Phase 2: agent, memory, recommendations -----------------------------------
# sgr = SGR agent with memory + recs + TV commands (default); chat = plain voice
# chat; stub = scripted test double.
AGENT_IMPL=sgr
LOG_LEVEL=INFO
# Sent on every LLM call (JSON). Thinking is always off: instruct models ignore
# it, reasoning models (Nemotron, DeepSeek) need it or they think for seconds first.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Loop bounds. AGENT_MAX_CYCLES = LLM round trips per turn (1–4); each extra
# cycle is ~1 s of waiting the viewer hears, 2 is the measured sweet spot.
# Every cycle after the first must start speaking within CYCLE_FIRST_BYTE_S or
# the tool results are spoken from a template. The envelope's own `say`
# ("Let me look.") is the filler while tools run; there is no canned one.
AGENT_MAX_CYCLES=2
CYCLE_FIRST_BYTE_S=1.2

# Catalog + query embeddings. `local` = multilingual-e5-small in-process (~15 ms/query);
# `nebius` = the cloud model below (200-500 ms; timed out in the field).
# The index must be built with the same provider: rebuild with tools/build_catalog.py after switching.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# Long-term memory: one profile per user (data/memory/<user_id>/profile.md), rewritten by
# MEMORY_MODEL (default: LLM_MODEL) from the session transcript when the session ends and,
# off the turn, every MEMORY_REFRESH_EVERY_TURNS turns (0 = session end only) so what the
# viewer said this session reaches the prompt before it ends.
# Titles are never part of it — history.db is the viewing log. Edit the .md by hand if needed.
MEMORY_MODEL=
MEMORY_PROFILE_MAX_WORDS=200
MEMORY_REFRESH_EVERY_TURNS=6
