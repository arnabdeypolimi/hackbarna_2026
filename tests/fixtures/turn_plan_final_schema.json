{
  "name": "turn_plan_final",
  "schema": {
    "$defs": {
      "Back": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "back",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Close": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "close",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Focus": {
        "additionalProperties": false,
        "properties": {
          "title_id": {
            "type": "string"
          },
          "verb": {
            "const": "focus",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_id"
        ],
        "type": "object"
      },
      "HideAmbient": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "hide_ambient",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Home": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "home",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Navigate": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "type": "string"
          },
          "verb": {
            "const": "navigate",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "direction",
          "count"
        ],
        "type": "object"
      },
      "OpenDetails": {
        "additionalProperties": false,
        "properties": {
          "title_id": {
            "type": "string"
          },
          "verb": {
            "const": "open_details",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_id"
        ],
        "type": "object"
      },
      "Pause": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "pause",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Play": {
        "additionalProperties": false,
        "properties": {
          "resume_from": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title_id": {
            "type": "string"
          },
          "verb": {
            "const": "play",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_id",
          "resume_from"
        ],
        "type": "object"
      },
      "RejectTitle": {
        "additionalProperties": false,
        "description": "Internal: the viewer declined a title that was offered. Recorded in the\nviewing log so it is not recommended again or offered at the next greeting.\nFire-and-forget — no result comes back and no second cycle follows.",
        "properties": {
          "title_id": {
            "type": "string"
          },
          "verb": {
            "const": "reject_title",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_id"
        ],
        "type": "object"
      },
      "Request": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "description": "play/open/shop need one specific movie the viewer named or pointed at on screen ('the second one'). A mood, a genre, 'you pick', 'surprise me' or 'something ...' is discover, even when they say 'put something on'.",
            "enum": [
              "play",
              "open",
              "lookup",
              "discover",
              "shop",
              "control",
              "answer"
            ],
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The movie the viewer named, verbatim; null when they named none."
          },
          "title_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its id when the Screen, Shop, Recent activity, Recommendations or a tool result lists it; null means search first, never guess."
          }
        },
        "required": [
          "operation",
          "title",
          "title_id"
        ],
        "type": "object"
      },
      "Resume": {
        "additionalProperties": false,
        "properties": {
          "verb": {
            "const": "resume",
            "type": "string"
          }
        },
        "required": [
          "verb"
        ],
        "type": "object"
      },
      "Seek": {
        "additionalProperties": false,
        "properties": {
          "delta_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Relative jump from where playback is: 'skip ahead thirty seconds' is 30, 'go back ten' is -10."
          },
          "to_seconds": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absolute position: 'go to the two-minute mark', 'start over' (0)."
          },
          "verb": {
            "const": "seek",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "to_seconds",
          "delta_seconds"
        ],
        "type": "object"
      },
      "ShowAmbient": {
        "additionalProperties": false,
        "description": "Put a relaxing scene on full screen, looping, with its own sound. The TV\nopens with a starter clip it ships with, makes the full video behind it\n(frontend/src/ambient) and keeps that for the next request, so nothing waits\non a session and a scene asked for again costs nothing.",
        "properties": {
          "scene": {
            "enum": [
              "garden",
              "beach",
              "fireplace"
            ],
            "type": "string"
          },
          "verb": {
            "const": "show_ambient",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "scene"
        ],
        "type": "object"
      },
      "ShowProducts": {
        "additionalProperties": false,
        "properties": {
          "scene_at": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title_id": {
            "type": "string"
          },
          "verb": {
            "const": "show_products",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_id",
          "scene_at"
        ],
        "type": "object"
      },
      "ShowTitles": {
        "additionalProperties": false,
        "description": "Put a rail of the agent's picks on screen. `focus` can only highlight a\ntitle already showing; recommendations usually are not, so without this the\nagent could only describe them.",
        "properties": {
          "label": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "title_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          },
          "verb": {
            "const": "show_titles",
            "type": "string"
          }
        },
        "required": [
          "verb",
          "title_ids",
          "label"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "actions": {
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/Play"
            },
            {
              "$ref": "#/$defs/Pause"
            },
            {
              "$ref": "#/$defs/Resume"
            },
            {
              "$ref": "#/$defs/Seek"
            },
            {
              "$ref": "#/$defs/Navigate"
            },
            {
              "$ref": "#/$defs/Focus"
            },
            {
              "$ref": "#/$defs/OpenDetails"
            },
            {
              "$ref": "#/$defs/Close"
            },
            {
              "$ref": "#/$defs/Back"
            },
            {
              "$ref": "#/$defs/Home"
            },
            {
              "$ref": "#/$defs/ShowProducts"
            },
            {
              "$ref": "#/$defs/ShowTitles"
            },
            {
              "$ref": "#/$defs/ShowAmbient"
            },
            {
              "$ref": "#/$defs/HideAmbient"
            },
            {
              "$ref": "#/$defs/RejectTitle"
            }
          ]
        },
        "type": "array"
      },
      "intent": {
        "enum": [
          "control",
          "navigate",
          "recommend",
          "search",
          "answer",
          "chitchat",
          "clarify"
        ],
        "type": "string"
      },
      "request": {
        "$ref": "#/$defs/Request"
      },
      "say": {
        "type": "string"
      }
    },
    "required": [
      "intent",
      "request",
      "say",
      "actions"
    ],
    "type": "object"
  },
  "strict": true
}
